# dsh-red-blue-team 部署环境变量模板
# 用法：cp .env.example .env，填写后启动。.env 已 gitignore，绝不入库。
#
# ===== LLM 接入（火山方舟 Agent Plan / OpenAI 兼容）=====
DEEPSEEK_API_KEY=                     # 必填：ark-xxx
DEEPSEEK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_DISABLE_THINKING=1           # 推理模型 content 直出（dpv4flash 等必需）

# ===== 面板访问令牌（企业级：生产必填，防止面板裸奔）=====
# 设置后 Web 面板所有 /api 接口要求 Authorization: Bearer <token>；
# 未设置时内网/开发模式放行。
REDTEAM_API_TOKEN=

# ===== 部署端口 =====
REDTEAM_PORT=8766
